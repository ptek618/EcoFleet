# Environment variables for EcoFleet APU Backend
# Copy this file to .env and fill in the actual values

# Secret key for JWT token signing (generate a secure random string)
SECRET_KEY=your-secret-key-here

# JWT algorithm (recommended: HS256)
ALGORITHM=HS256

# CORS origins (comma-separated list of allowed origins)
# For production, set this to your frontend URL
CORS_ORIGINS=*

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./ecofleet.db

# Environment (development, production)
ENVIRONMENT=production
